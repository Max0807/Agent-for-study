# Copy this file to .env and set your own DeepSeek API key.
# Never commit the real .env file or a real API key.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Day6 document parsing settings (bytes for max upload size).
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
DOCUMENT_MAX_UPLOAD_SIZE=10485760

# Day7 local Embedding and Chroma vector database settings.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_DB_PATH=data/chroma
VECTOR_COLLECTION=company_knowledge
EMBEDDING_BATCH_SIZE=32
SEARCH_TOP_K=5

# Day8 Naive RAG settings.
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_OUTPUT_TOKENS=800

# Day9 retrieval quality gate and multi-turn history limits.
RAG_MAX_DISTANCE=0.55
RAG_HISTORY_MAX_MESSAGES=8
RAG_HISTORY_MAX_CHARS=6000
