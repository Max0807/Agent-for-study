# Copy this file to .env and set your own DeepSeek API key.
# Never commit the real .env file or a real API key.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Day6 document parsing settings (bytes for max upload size).
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
DOCUMENT_MAX_UPLOAD_SIZE=10485760
